# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# ─── Multi-LLM API Keys ──────────────────────────────────────────────────────
# PRIMARY — required (all Groq models are free-tier friendly)
GROQ_API_KEY=gsk_your_groq_key_here

# OPTIONAL — enables multi-LLM consensus reviews
OPENAI_API_KEY=sk-your_openai_key_here
GOOGLE_API_KEY=your_google_gemini_key_here

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@db:5432/pr_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pr_platform

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Qdrant ──────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=codebase_memory

# ─── Notifications (optional) ────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0XXXXXXXXX
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# ─── AWS S3 (optional, for PDF export) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_S3_BUCKET=pr-platform-reports
AWS_REGION=us-east-1

# ─── Backend Internal ────────────────────────────────────────────────────────
SECRET_KEY=generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
